<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.suplab.agentharness</groupId>
  <artifactId>halo-agent-harness</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>halo-agent-harness (Java binding)</name>
  <description>
    Java binding of the agent-harness protocol (docs/spec/harness-protocol.md): typed decision envelope,
    centralized non-disableable confidence gate, default-deny tool registry, orchestration, and pluggable
    ports. Framework-free (plain Java 21, no Spring). Brand-neutral.
  </description>
  <url>https://github.com/doubts-suplab/agent-harness</url>

  <!-- Metadata below is required by Maven Central; inert for the normal build/test cycle. -->
  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>doubts-suplab</id>
      <name>doubts-suplab</name>
      <url>https://github.com/doubts-suplab</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/doubts-suplab/agent-harness.git</connection>
    <developerConnection>scm:git:git@github.com:doubts-suplab/agent-harness.git</developerConnection>
    <url>https://github.com/doubts-suplab/agent-harness</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <!-- Published to GitHub Packages by .github/workflows/publish-java.yml on a GitHub Release.
       Consumers (e.g. aether-grid) resolve com.suplab.agentharness:halo-agent-harness from this repository
       (requires a token with read:packages in their Maven settings). -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/doubts-suplab/agent-harness</url>
    </repository>
  </distributionManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Maven Central release. Activated only by `mvn -Prelease deploy` (see
         .github/workflows/publish-maven-central.yml); the normal build/test cycle never touches it.
         Requires CENTRAL_TOKEN_* + a GPG signing key at deploy time (gated on org credentials). -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.7.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Leave staged for a human to release in the Central portal, rather than auto-publishing. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
